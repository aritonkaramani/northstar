# Battle.net OAuth credentials
# Get these from https://develop.battle.net/access/clients
BNET_CLIENT_ID=your_client_id_here
BNET_CLIENT_SECRET=your_client_secret_here

# The full URL Blizzard redirects back to after login
# Production: https://www.northstarguild.com/api/auth/callback
# Local dev:  http://localhost:3000/api/auth/callback
BNET_CALLBACK_URL=https://www.northstarguild.com/api/auth/callback

# A long random secret used to sign session JWTs
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
